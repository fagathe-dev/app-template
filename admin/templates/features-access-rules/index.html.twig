{% extends "@admin/layout.html.twig" %}

{% block body %}
  <div class="container mt-5">
    <div class="row justify-content-center">
      <h1 class="h3 d-flex justify-content-between">
        Liste des permissions
        <a href="{{ path('admin_features_access_rules_new') }}" class="btn btn-success">
          <i class="bi bi-plus-circle"></i> Ajouter
        </a>
      </h1>

    <table class="table table-striped table-hover">
      <thead>
        <tr>
          <th scope="col">ID</th>
          <th scope="col">Nom</th>
          <th scope="col">Activée</th>
          <th scope="col">Rôle Minimum</th>
          <th scope="col">Propriétaire requis</th>
          <th scope="col">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for feature in features %}
          <tr>
            <th scope="row">{{ feature.id }}</th>
            <td>{{ feature.name }}</td>
            <td>
              {% if feature.enabled %}
                <span class="badge bg-success">Oui</span>
              {% else %}
                <span class="badge bg-danger">Non</span>
              {% endif %}
            </td>
            <td>
              {% if feature.minimumAccessRole %}
                <span class="badge border border-secondary text-secondary">{{ nice_role(feature.minimumAccessRole) }}</span>
              {% else %}
                <span class="badge border border-light text-dark">Accès publique</span>
              {% endif %}
            </td>
            <td>
              {% if feature.requiresOwnerMatch %}
                <span class="badge bg-warning text-dark">Oui</span>
              {% else %}
                <span class="badge bg-light text-dark">Non</span>
              {% endif %}
            </td>
            <td>
              <a href="{{ path('admin_features_access_rules_edit', {'id': feature.id}) }}" class="btn btn-sm btn-primary">
                <i class="bi bi-pencil-square"></i> Éditer
              </a>
              <a href="{{ path('admin_features_access_rules_delete', {'id': feature.id}) }}" class="btn btn-sm btn-danger" onclick="deleteFeature(event)">
                <i class="bi bi-trash"></i> Supprimer
              </a>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="6" class="text-center">Aucune fonctionnalité configurée.</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
    </div>
  </div>
{% endblock %}

{% block javascripts %}
  <script src="{{ asset('js/features-access-rules.js') }}"></script>
{% endblock %}