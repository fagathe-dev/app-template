{% extends "@admin/layout.html.twig" %}

{% block body %}
  <div class="row justify-content-beetwen g-2 mb-3">

    <div class="col">
      <div class="d-flex align-items-center">
        <div class="flex-shrink-0 me-2 d-block d-lg-none">
          <button type="button" class="btn btn-soft-success btn-icon btn-sm fs-16 file-menu-btn">
            <i class="ri-menu-2-fill align-bottom"></i>
          </button>
        </div>
        <div class="flex-grow-1">
          <h5 class="fs-16 mb-0">Folders</h5>
        </div>
      </div>
    </div>
    <!--end col-->
    <div class="col-auto">
        <div class="d-flex gap-2 align-items-start" id="logFilesFilter">
          <select name="logDay" id="logDay" class="form-select" onchange="setUpDate(event);">
            {% for day in dates %}
              <option value="{{ day }}">{{ day }}</option>
            {% endfor %}
          </select>

          <button class="btn btn-primary w-sm create-folder-modal flex-shrink-0"> <i class="ri-refresh-line align-bottom me-1"></i> Actualiser</button>
        </div>
    </div>
    <!--end col-->
</div>
{% endblock %}

{% block javascripts %}
  <script>
    const API_LOG_FILES_GET = '{{ url('admin_log_files') }}';
    var exports = {};
  </script>
  <script type="module" src="{{ asset('js/admin/log.js') }}"></var>
{% endblock %}