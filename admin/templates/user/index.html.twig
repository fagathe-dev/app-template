{% extends "@admin/layout.html.twig" %}

{% block body %}
  <div class="container mt-5">
    <div class="row justify-content-center">
      <h1 class="h3 d-flex justify-content-between">
        Liste des utilisateurs
        <a href="{{ path('admin_user_create') }}" class="btn btn-success">
          <i class="bi bi-plus-circle"></i> Ajouter
        </a>
      </h1>

    <table class="table table-striped table-hover">
      <thead>
        <tr>
          <th scope="col">ID</th>
          <th scope="col">Nom</th>
          <th scope="col">E-mail</th>
          <th scope="col">Activée</th>
          <th scope="col">Rôle</th>
          <th scope="col">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for user in paginatedUsers %}
          <tr>
            <th scope="row">{{ user.id }}</th>
            <td>{{ user.username }}</td>
            <td>{{ user.email }}</td>
            <td>
              {% if user.active %}
                <span class="badge bg-success">Oui</span>
              {% else %}
                <span class="badge bg-danger">Non</span>
              {% endif %}
            </td>
            <td>
              {% if user.roles %}
                <span class="badge bg-secondary text-white">{{ roles(user) }}</span>
              {% else %}
                <span class="badge bg-light text-dark">Accès publique</span>
              {% endif %}
            </td>
            <td>
              <a href="{{ path('admin_user_edit', {'id': user.id}) }}" class="btn btn-sm btn-primary">
                <i class="bi bi-pencil-square"></i> Éditer
              </a>
              <a href="{{ path('admin_user_delete', {'id': user.id}) }}" class="btn btn-sm btn-danger" onclick="deleteFeature(event);">
                <i class="bi bi-trash"></i> Supprimer
              </a>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="6" class="text-center">Aucune fonctionnalité configurée.</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
    <div class="mb-3">
      {{ knp_pagination_render(paginatedUsers) }}
    </div>
    </div>
  </div>
{% endblock %}

{% block javascripts %}
  <script src="{{ asset('js/admin/features-access-rules.js') }}"></script>
{% endblock %}