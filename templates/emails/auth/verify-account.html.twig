{% extends "emails/base.html.twig" %}

{% block content %}
  {# Titre de bienvenue avec emoji #}
  {% include "emails/components/heading.html.twig" with {
    'text': user.name ?? user.username,
    'emoji': '👋',
    'center': true
  } %}

  {# Titre principal #}
  {% include "emails/components/heading.html.twig" with {
    'text': 'Merci de vous être inscrit sur notre application 🙏',
    'center': true
  } %}

  {# Message d'explication #}
  {% include "emails/components/paragraph.html.twig" with {
    'content': '<p style="margin-bottom: 0;">Un email pour vérifier</p><p style="margin-bottom: 0;">Veuillez valider votre adresse email afin de commencer à utiliser notre produit.</p>',
    'center': true
  } %}

  {# Bouton de vérification #}
  {% include "emails/components/button.html.twig" with {
    'url': activation_link,
    'text': 'Vérifiez votre email',
    'color': '#4b38b3'
  } %}

  {# Lien de fallback #}
  {% include "emails/components/link-fallback.html.twig" with {
    'url': activation_link
  } %}
{% endblock %}